\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Simulation of the Wilson--Cowan model across 80 brain regions using Neurolib~2. The figure illustrates the spatiotemporal dynamics of excitatory and inhibitory populations, demonstrating inter-regional interactions mediated by structural connectivity and conduction delays. Stochastic fluctuations are introduced via Ornstein--Uhlenbeck noise, highlighting variability around deterministic trajectories.}}{7}{figure.1}\protected@file@percent }
\newlabel{fig:wilson_cowan_dynamics}{{1}{7}{Simulation of the Wilson--Cowan model across 80 brain regions using Neurolib~2. The figure illustrates the spatiotemporal dynamics of excitatory and inhibitory populations, demonstrating inter-regional interactions mediated by structural connectivity and conduction delays. Stochastic fluctuations are introduced via Ornstein--Uhlenbeck noise, highlighting variability around deterministic trajectories}{figure.1}{}}
